; NVT with constraints and v-rescale thermostat
; Same as step6.1 but without the position restraints
; define                  = -DPOSRES -DPOSRES_FC_LIPID=1000.0 -DDIHRES -DDIHRES_FC=1000.0
integrator              = md
dt                      = 0.002 ; Note this is in picoseconds
nsteps                  = 10000000 ; 20ns should be enough for NVT, maybe?
nstxtcout               = 2000
nstvout                 = 2000
nstfout                 = 2000
nstcalcenergy           = 100
nstenergy               = 2000
nstlog                  = 2000
;
pbc                     = xy ; periodic boundary conditions
cutoff-scheme           = Verlet
nstlist                 = 100
rlist                   = 1.2
vdwtype                 = Cut-off
vdw-modifier            = Force-switch
rvdw_switch             = 1.0
rvdw                    = 1.2
coulombtype             = PME
rcoulomb                = 1.2
DispCorr                = no

;
ewald-geometry          = 3dc

; Walls
nwall                    = 2
wall-atomtype            = C C      ; atom types for the walls
wall-type                = 12-6     ; Lennard-Jones 12-6 potential for the walls
; wall-r-linpot            = 1.0 ; uncommenting this seems to cause GROMACs to break on CUDA
wall-density             = 10 10
wall-ewald-zfac          = 3

;
tcoupl                  = v-rescale
tc_grps                 = system
tau_t                   = 1.0
ld-seed                 = -1
ref_t                   = 300
;
constraints             = h-bonds
constraint_algorithm    = LINCS
;
nstcomm                 = 100
comm_mode               = linear
comm_grps               = system
;
gen-vel                 = no ; This seems to cause the simulation to slide down the box, which we don't want.
continuation            = yes ; We should be able to get away with generating new velocities each time if we equilibrate long enough
;gen-vel                 = yes
;gen-temp                = 303.15
;gen-seed                = -1
;
