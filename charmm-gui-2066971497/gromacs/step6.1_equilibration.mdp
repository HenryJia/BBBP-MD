; NVT with constraints and v-rescale thermostat
define                  = -DPOSRES -DPOSRES_FC_LIPID=1000.0 -DDIHRES -DDIHRES_FC=1000.0
integrator              = md
dt                      = 0.002 ; Note this is in picoseconds
nsteps                  = 10000000 ; 20ns should be enough for NVT, maybe?
nstxtcout               = 2000
nstvout                 = 2000
nstfout                 = 2000
nstcalcenergy           = 100
nstenergy               = 2000
nstlog                  = 2000
;
pbc                     = xyz ; periodic boundary conditions
cutoff-scheme           = Verlet
nstlist                 = 200
rlist                   = 1.2
vdwtype                 = Cut-off
vdw-modifier            = Force-switch
rvdw_switch             = 1.0
rvdw                    = 1.2
coulombtype             = PME
rcoulomb                = 1.2
DispCorr                = no
;
tcoupl                  = v-rescale
tc_grps                 = system
tau_t                   = 1.0
ld-seed                 = -1
ref_t                   = 300
;
constraints             = h-bonds
constraint_algorithm    = LINCS
;
nstcomm                 = 100
comm_mode               = linear
comm_grps               = system
;
gen-vel                 = yes
gen-temp                = 303.15
gen-seed                = -1
;
