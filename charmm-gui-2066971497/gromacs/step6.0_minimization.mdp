define                  = -DPOSRES -DPOSRES_FC_LIPID=1000.0 -DDIHRES -DDIHRES_FC=1000.0
integrator              = steep
emtol                   = 100.0 ; 1000.0
nsteps                  = 100000 ; 5000

; Neighborsearching and short-range nonbonded interactions
nstlist                 = 200 ; default was 10
cutoff-scheme           = Verlet
pbc                     = xy ; periodic boundary conditions
rlist                   = 1.2
vdwtype                 = Cut-off
vdw-modifier            = Force-switch
rvdw_switch             = 1.0
rvdw                    = 1.2
coulombtype             = PME
rcoulomb                = 1.2

constraints             = h-bonds
constraint_algorithm    = LINCS

ewald-geometry          = 3dc ; Will be set to 3dc when we do the 3 times z with vacuum thing

; Walls, only needed if we're doing the 3 times z with vacuum thing
nwall                    = 2
wall-atomtype            = C C      ; atom types for the walls
wall-type                = 12-6     ; Lennard-Jones 12-6 potential for the walls
wall-r-linpot            = 1.0
wall-density             = 10 10
wall-ewald-zfac          = 2 ; I think this should be set for when we do ewald-geometry = 3dc?
