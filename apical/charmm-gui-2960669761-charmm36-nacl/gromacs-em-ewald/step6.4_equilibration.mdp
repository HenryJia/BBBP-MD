define                  = -DPOSRES -DPOSRES_FC_LIPID=0.001 ; -DDIHRES -DDIHRES_FC=1000.0
integrator              = md
dt                      = 0.002
nsteps                  = 250000
nstxout-compressed      = 5000
nstxout                 = 0
nstvout                 = 0
nstfout                 = 0
nstcalcenergy           = 100
nstenergy               = 1000
nstlog                  = 1000
;
cutoff-scheme           = Verlet
nstlist                 = 100 ;20
rlist                   = 1.2
vdwtype                 = Cut-off
vdw-modifier            = Force-switch
rvdw_switch             = 1.0
rvdw                    = 1.2
coulombtype             = PME
rcoulomb                = 1.2
;
tcoupl                  = v-rescale
tc_grps                 = MEMB SOLV
tau_t                   = 1.0 1.0
ref_t                   = 310 310
;
pcoupl                  = C-rescale
pcoupltype              = semiisotropic 
tau_p                   = 5.0
compressibility         = 4.5e-5  4.5e-5
ref_p                   = 1.0     1.0
refcoord_scaling        = com
;
constraints             = h-bonds
constraint_algorithm    = LINCS
continuation            = yes
;
nstcomm                 = 100
comm_mode               = linear
comm_grps               = MEMB SOLV

;
pbc                     = xy ; periodic boundary conditions
;
ewald-geometry          = 3dc
; Walls
nwall                    = 2
wall-atomtype            = C C      ; atom types for the walls
wall-type                = 12-6     ; Lennard-Jones 12-6 potential for the walls
; wall-r-linpot            = 1.0 ; uncommenting this seems to cause GROMACs to break on CUDA
wall-density             = 10 10
wall-ewald-zfac          = 3

