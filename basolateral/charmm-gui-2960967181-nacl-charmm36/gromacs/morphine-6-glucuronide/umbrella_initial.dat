# Volume of the simulation box
vol: VOLUME
# Total potential energy of the simulation box
G: ENERGY

# PLUMED PBC is somewhat initially uintuitive. It will treat the biundaries as the 0 coordinate from both sides, and thus always try to pick the one closest to 0
# We will use NOPBC for position, so that it doesn't do this and does cartesian coordinates normally. We do need to keep it enabled for COM however
c: COM ATOMS=42720-42779
p: POSITION ATOM=c NOPBC

t: TIME

mr: MOVINGRESTRAINT ARG=p.z STEP0=0 AT0=8.0 KAPPA0=250 STEP1=7000000 AT1=1.0 KAPPA1=250

# We need these walls to have very high force constants to guarrantee they don't go outside of the boundaries
uwall: UPPER_WALLS ARG=p.z AT=8.5 KAPPA=2000.0 EXP=2 EPS=1 OFFSET=0
lwall: LOWER_WALLS ARG=p.z AT=0.5 KAPPA=2000.0 EXP=2 EPS=1 OFFSET=0

# Since we're running a biased simulation, we need to reweight the bias when computing our free energy
# Technically, we don't care about this histogram since this run is just for generating initial configuration
# But, we'll dump the free energies anyway and see what happens
rwbias: REWEIGHT_BIAS ARG=mr.bias #,uwall.bias,lwall.bias # TEMP=310
h: HISTOGRAM ARG=p.z STRIDE=1 GRID_MIN=0.5 GRID_MAX=8.5 GRID_BIN=800 BANDWIDTH=0.1 NORMALIZATION=true LOGWEIGHTS=rwbias

# Convert the histogram to free energy
fe: CONVERT_TO_FES GRID=h # TEMP=310

# This should leave a little bit of space for our molecule to wander around, but not enough to affect the membrane

DUMPGRID GRID=fe FILE=umbrella_initial_fe STRIDE=500000
PRINT ARG=G,vol,p.x,p.y,p.z,mr.bias,uwall.bias,lwall.bias,rwbias STRIDE=1000 FILE=umbrella_initial_out
