# Template for Jarzynski sampling with Plumed 2.8 and GROMACS

# Volume of the simulation box
vol: VOLUME
# Total potential energy of the simulation box
G: ENERGY

# PLUMED PBC is somewhat initially uintuitive. It will treat the biundaries as the 0 coordinate from both sides, and thus always try to pick the one closest to 0
# We will use NOPBC for position, so that it doesn't do this and does cartesian coordinates normally. We do need to keep it enabled for COM however
c: COM ATOMS=42774-42785
p: POSITION ATOM=c NOPBC

# Put some walls in so we don't have to deal with periodic boundary conditions for our ligand
# We need these walls to have very high force constants to guarrantee they don't go outside of the boundaries
uwall: UPPER_WALLS ARG=p.z AT=8.0 KAPPA=2000.0 EXP=2 EPS=1 OFFSET=0
lwall: LOWER_WALLS ARG=p.z AT=1.0 KAPPA=2000.0 EXP=2 EPS=1 OFFSET=0

ANN ...
  LABEL=fesfit
  ARG=p.z
  NUM_LAYERS=3
  NUM_NODES=1,20,1
  ACTIVATIONS=Tanh,Linear
  WEIGHTS0=1.0141164742728026,-3.6713487772925153,-3.9186127276538545,-0.9867726606574532,1.3792433677679392,-3.319113639317357,3.669446335739327,5.635522226315004,-1.0641546543355689,3.7574965608239537,2.345978714956649,-3.077411029036403,-0.8289138677346957,-0.27528520381577865,-3.572567970901484,3.67451592399292,-3.824577759337205,7.610371167638627,2.148057092171453,-2.500023641925261
  WEIGHTS1=11.039260509784356,-2.117860998713152,-2.0377708559432675,3.0042550966297745,16.921322766592894,-0.9057628363234346,1.4693420005708275,-1.8555605838562326,8.248584765280794,2.0557271213985953,-6.6010247762579075,-0.508071248874113,1.527435120457844,-9.844180787823593,-1.5212269680847288,1.5592010288763376,-1.4525745969047448,1.0086085366175426,-18.23105192888515,8.90349450976373
  BIASES0=-4.526439139450412,7.19920611105986,9.265301397540833,3.1123492323911517,-7.760028105523097,5.152281066677661,-7.058674078556027,-1.151689731323024,7.630522437878901,-8.159780245295574,-6.785872432305946,1.7812034382795408,2.068392084933507,2.3062905509877742,5.861294745534629,-6.557710205486256,8.028107496467927,-1.7328307335145094,-13.719549006608059,10.162689283135892
  BIASES1=0.20909768826900593
... ANN

CUSTOM ARG=fesfit.node-0 FUNC=-1.0*x PERIODIC=NO LABEL=pot
BIASVALUE ARG=pot LABEL=b
REWEIGHT_BIAS ARG=b.bias LABEL=rwbias

HISTOGRAM ...
  ARG=p.z
  GRID_MIN=0.5
  GRID_MAX=8.5
  GRID_BIN=800
  BANDWIDTH=0.1
  LOGWEIGHTS=rwbias
  LABEL=h
... HISTOGRAM

CONVERT_TO_FES GRID=h LABEL=fe

DUMPGRID GRID=fe FILE=jarzynski_fe STRIDE=2500000
PRINT ARG=G,vol,p.x,p.y,p.z,pot,b.bias,uwall.bias,lwall.bias,rwbias STRIDE=1000 FILE=jarzynski_out