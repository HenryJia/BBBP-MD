# Template for Jarzynski sampling with Plumed 2.8 and GROMACS

# Volume of the simulation box
vol: VOLUME
# Total potential energy of the simulation box
G: ENERGY

# PLUMED PBC is somewhat initially uintuitive. It will treat the biundaries as the 0 coordinate from both sides, and thus always try to pick the one closest to 0
# We will use NOPBC for position, so that it doesn't do this and does cartesian coordinates normally. We do need to keep it enabled for COM however
c: COM ATOMS=42774-42785
p: POSITION ATOM=c NOPBC

# Put some walls in so we don't have to deal with periodic boundary conditions for our ligand
# We need these walls to have very high force constants to guarrantee they don't go outside of the boundaries
uwall: UPPER_WALLS ARG=p.z AT=8.0 KAPPA=2000.0 EXP=2 EPS=1 OFFSET=0
lwall: LOWER_WALLS ARG=p.z AT=1.0 KAPPA=2000.0 EXP=2 EPS=1 OFFSET=0

ANN ...
  LABEL=fesfit
  ARG=p.z
  NUM_LAYERS=3
  NUM_NODES=1,20,1
  ACTIVATIONS=Tanh,Linear
  WEIGHTS0=3.9176918348672527,1.3789753159653262,-1.2981599397076655,-4.192766539314845,-1.5977911414078496,3.4051054487562427,1.5883774008387812,-1.3623771241698794,2.8868385550991413,-0.5414057467644585,3.3773682418394393,-1.6041260654030953,4.228516004511841,4.0156595536925765,-4.674229455563403,3.8958428962166956,2.949515053353907,-4.146306163627652,-3.7766144871551437,-5.500391789974217
  WEIGHTS1=-1.7603563004510645,0.2772552294468484,-0.16185482095575088,1.2708247703243438,-0.5755341072253984,4.284427463659962,20.13256828224953,-0.11035357830051068,5.874502494656226,2.235496173465444,-0.6039062197971862,19.189054139569595,-1.3441814540539399,-1.523564831840382,1.814411170571122,-0.3488285455340128,0.1817869325453554,1.464130709964167,1.501284673527331,-0.21182525935964513
  BIASES0=-7.4272353250034255,-1.3274138259999346,1.3192738039816545,8.621565628862882,4.533196861933902,-13.476748586089704,-10.332240102438487,1.2906293817414316,-8.473190038877485,-0.06783339290561771,-5.765256732869635,8.638151735630387,-9.24324809769838,-7.793353872403907,10.573144802582487,-2.281978188530156,-0.5201861167646298,6.474923747603629,6.778779793821298,0.2635649106723828
  BIASES1=0.14975177732547545
... ANN

CUSTOM ARG=fesfit.node-0 FUNC=-1.0*x PERIODIC=NO LABEL=pot
BIASVALUE ARG=pot LABEL=b
REWEIGHT_BIAS ARG=b.bias LABEL=rwbias

HISTOGRAM ...
  ARG=p.z
  GRID_MIN=0.5
  GRID_MAX=8.5
  GRID_BIN=800
  BANDWIDTH=0.1
  LOGWEIGHTS=rwbias
  LABEL=h
... HISTOGRAM

CONVERT_TO_FES GRID=h LABEL=fe

DUMPGRID GRID=fe FILE=jarzynski_fe STRIDE=2500000
PRINT ARG=G,vol,p.x,p.y,p.z,dir,target,diff,pot,b.bias,uwall.bias,lwall.bias,rwbias STRIDE=1000 FILE=Jarzynski_out