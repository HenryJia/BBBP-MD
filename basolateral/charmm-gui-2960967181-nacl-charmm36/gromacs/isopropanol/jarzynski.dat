# Template for Jarzynski sampling with Plumed 2.8 and GROMACS

# Volume of the simulation box
vol: VOLUME
# Total potential energy of the simulation box
G: ENERGY

# PLUMED PBC is somewhat initially uintuitive. It will treat the biundaries as the 0 coordinate from both sides, and thus always try to pick the one closest to 0
# We will use NOPBC for position, so that it doesn't do this and does cartesian coordinates normally. We do need to keep it enabled for COM however
c: COM ATOMS=42774-42785
p: POSITION ATOM=c NOPBC

# Put some walls in so we don't have to deal with periodic boundary conditions for our ligand
# We need these walls to have very high force constants to guarrantee they don't go outside of the boundaries
uwall: UPPER_WALLS ARG=p.z AT=8.0 KAPPA=2000.0 EXP=2 EPS=1 OFFSET=0
lwall: LOWER_WALLS ARG=p.z AT=1.0 KAPPA=2000.0 EXP=2 EPS=1 OFFSET=0

ANN ...
  LABEL=fesfit
  ARG=p.z
  NUM_LAYERS=3
  NUM_NODES=1,20,1
  ACTIVATIONS=Tanh,Linear
  WEIGHTS0=1.163389077506349,1.0458977856469696,1.748982539910943,-3.3531709245971286,-2.6527193053852125,2.086169644358594,-1.9110825349704836,-1.5701989806099055,-3.147289366476086,2.3168069971657643,2.137329344279762,-2.6620280196314257,-1.3833795359710621,-2.149054979037322,3.1636986225637544,-0.8068849657627196,-3.221502196623911,2.5681504472539616,3.2562873252325786,-3.5035074010524423
  WEIGHTS1=-7.625698926849862,-6.768107849131057,11.801415079467542,2.1293203777924115,0.9627351606350149,4.037253178852189,-13.654101685797109,13.29817939202702,1.7517275821226939,2.812752474145339,0.9745646869189389,-3.8760471318851266,11.760031978581367,-2.5178068085619087,-2.4432230231056815,-8.777952629001659,2.837607298236501,6.400399229976995,-2.39845816877741,2.7959762117487874
  BIASES0=-5.429809593242933,-4.853501827375782,-11.01492685423647,5.227597822723964,2.0015741146589807,-8.07733520832394,12.137950346047791,8.98323892760799,5.955523555164687,-6.575330640137004,-2.3416618833244423,7.806171774124297,8.326314449558895,5.297506624189169,-7.517997846185056,5.287733030308213,6.737401372565721,-10.68074545312332,-7.130285626053137,6.491970871673727
  BIASES1=-0.4772509763833116
... ANN

CUSTOM ARG=fesfit.node-0 FUNC=-1.0*x PERIODIC=NO LABEL=pot
BIASVALUE ARG=pot LABEL=b
REWEIGHT_BIAS ARG=b.bias LABEL=rwbias

HISTOGRAM ...
  ARG=p.z
  GRID_MIN=0.5
  GRID_MAX=8.5
  GRID_BIN=800
  BANDWIDTH=0.1
  LOGWEIGHTS=rwbias
  LABEL=h
... HISTOGRAM

CONVERT_TO_FES GRID=h LABEL=fe
fe: CONVERT_TO_FES GRID=h

DUMPGRID GRID=fe FILE=jarzynski_fe STRIDE=2500000
PRINT ARG=G,vol,p.x,p.y,p.z,dir,target,diff,pot,b.bias,uwall.bias,lwall.bias,rwbias STRIDE=1000 FILE=Jarzynski_out