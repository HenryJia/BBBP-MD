# Template for Jarzynski sampling with Plumed 2.8 and GROMACS

# Volume of the simulation box
vol: VOLUME
# Total potential energy of the simulation box
G: ENERGY

# PLUMED PBC is somewhat initially uintuitive. It will treat the biundaries as the 0 coordinate from both sides, and thus always try to pick the one closest to 0
# We will use NOPBC for position, so that it doesn't do this and does cartesian coordinates normally. We do need to keep it enabled for COM however
c: COM ATOMS=42774-42785
p: POSITION ATOM=c NOPBC

# Put some walls in so we don't have to deal with periodic boundary conditions for our ligand
# We need these walls to have very high force constants to guarrantee they don't go outside of the boundaries
uwall: UPPER_WALLS ARG=p.z AT=8.0 KAPPA=2000.0 EXP=2 EPS=1 OFFSET=0
lwall: LOWER_WALLS ARG=p.z AT=1.0 KAPPA=2000.0 EXP=2 EPS=1 OFFSET=0

ANN ...
  LABEL=fesfit
  ARG=p.z
  NUM_LAYERS=3
  NUM_NODES=1,20,1
  ACTIVATIONS=Tanh,Linear
  WEIGHTS0=3.410967346042048,-2.963657951566125,3.512875727920289,-1.6234480540681755,1.6427531919380993,1.2710596929257405,2.6602344905328965,-3.3352114623649083,2.179028372894277,-0.8750367648601115,4.745814210920358,3.6250631872583563,2.5122908262038335,3.5460271325642343,-3.334557658599619,-2.2368196634453668,0.4543122553532348,1.2745307055452397,3.140120182301299,3.4170841552353686
  WEIGHTS1=-1.4452079404125968,1.1004061404259378,-1.5811027806662228,-4.529966287705943,0.38246058210593814,-21.042957135142043,3.1082918580861367,-5.103722338436637,14.193807408139012,-1.4510447285374246,-0.38505921908334234,-1.9867500378898155,2.678069149402751,-2.0315896505793867,1.9373929075352754,-3.0261867935954565,-3.4084484921645135,4.35430213030739,-0.9671040534042837,-2.101558194906887
  BIASES0=-6.405334004162445,5.709669441715798,-6.5560299931848816,10.391317712910524,-2.582705518549886,-6.9494708890420664,-7.401614518975746,13.429951366586977,-13.980167566556725,8.46344390234515,-2.8878450993621487,-5.787638269932023,-6.93679132419235,-7.698969366451862,8.113174483588963,7.027430619592444,-2.4240217313217487,-9.093111104375872,-5.99787653141493,-7.238834303212274
  BIASES1=0.2861531964115385
... ANN

CUSTOM ARG=fesfit.node-0 FUNC=-1.0*x PERIODIC=NO LABEL=pot
BIASVALUE ARG=pot LABEL=b
REWEIGHT_BIAS ARG=b.bias LABEL=rwbias

HISTOGRAM ...
  ARG=p.z
  GRID_MIN=0.5
  GRID_MAX=8.5
  GRID_BIN=800
  BANDWIDTH=0.1
  LOGWEIGHTS=rwbias
  LABEL=h
... HISTOGRAM

CONVERT_TO_FES GRID=h LABEL=fe

DUMPGRID GRID=fe FILE=jarzynski_fe STRIDE=2500000
PRINT ARG=G,vol,p.x,p.y,p.z,pot,b.bias,uwall.bias,lwall.bias,rwbias STRIDE=1000 FILE=jarzynski_out