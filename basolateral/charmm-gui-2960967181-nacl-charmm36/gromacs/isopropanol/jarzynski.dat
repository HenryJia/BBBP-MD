# Template for Jarzynski sampling with Plumed 2.8 and GROMACS

# Volume of the simulation box
vol: VOLUME
# Total potential energy of the simulation box
G: ENERGY

# PLUMED PBC is somewhat initially uintuitive. It will treat the biundaries as the 0 coordinate from both sides, and thus always try to pick the one closest to 0
# We will use NOPBC for position, so that it doesn't do this and does cartesian coordinates normally. We do need to keep it enabled for COM however
c: COM ATOMS=42774-42785
p: POSITION ATOM=c NOPBC

# Put some walls in so we don't have to deal with periodic boundary conditions for our ligand
# We need these walls to have very high force constants to guarrantee they don't go outside of the boundaries
uwall: UPPER_WALLS ARG=p.z AT=8.0 KAPPA=2000.0 EXP=2 EPS=1 OFFSET=0
lwall: LOWER_WALLS ARG=p.z AT=1.0 KAPPA=2000.0 EXP=2 EPS=1 OFFSET=0

ANN ...
  LABEL=fesfit
  ARG=coord.morethan
  NUM_LAYERS=3
  NUM_NODES=1,20,1
  ACTIVATIONS=Tanh,Linear
  WEIGHTS0=-1.73069599973009,-1.5360136505166355,2.2380750068624176,-2.766543220327403,3.1000067812951206,-1.0553877364264697,-0.5095125126627447,-3.211785278676079,-3.222654726117658,3.296603896213166,2.323479191624197,-2.493868711160675,-3.314098379206288,3.467835388508072,-5.012005162805012,3.124490618874319,1.2851863474468055,1.3550136871393184,-1.430926420650927,-1.3932827228095506
  WEIGHTS1=-3.6624230521153227,12.988653286795698,5.254625008188696,0.8973198716665843,-2.3054676213652994,8.176961783042664,0.5447293709309025,1.9091036321665558,1.7639428197562756,-1.001013578027486,3.948760700190772,-4.514726412823417,1.8603656964607682,-1.9453447707767086,0.3550509963760745,-1.9734883684824334,-11.533848749373112,9.605654150698397,-10.297106649520275,-9.262547776462263
  BIASES0=6.91035350374327,8.70774146006849,-9.042374610332446,5.189788101496757,-7.6599466414471316,4.908900850304221,-5.467759486985946,7.106064067238351,6.474661202365963,-5.60823015632928,-6.454136372501163,7.071379646668666,6.88020677974985,-5.779992407664379,2.9372873761035554,-6.140823171755113,-7.109859419241899,-8.639861363531107,9.054082314926065,8.840224099610635
  BIASES1=-0.23242109003688405
... ANN

CUSTOM ARG=fesfit.node-0 FUNC=-1.0*x PERIODIC=NO LABEL=pot
BIASVALUE ARG=pot LABEL=b
REWEIGHT_BIAS ARG=b.bias LABEL=rwbias

HISTOGRAM ...
  ARG=p
  GRID_MIN=0.5
  GRID_MAX=8.5
  GRID_BIN=800
  BANDWIDTH=0.1
  LOGWEIGHTS=rwbias
  LABEL=h
... HISTOGRAM

CONVERT_TO_FES GRID=h LABEL=fe
fe: CONVERT_TO_FES GRID=h

DUMPGRID GRID=fe FILE=jarzynski_fe STRIDE=2500000
PRINT ARG=G,vol,p.x,p.y,p.z,dir,target,diff,pot,b.bias,uwall.bias,lwall.bias,rwbias STRIDE=1000 FILE=Jarzynski_out