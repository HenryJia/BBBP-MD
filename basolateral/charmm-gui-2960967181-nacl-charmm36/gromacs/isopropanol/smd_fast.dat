# Volume of the simulation box
vol: VOLUME
# Total potential energy of the simulation box
G: ENERGY

# PLUMED PBC is somewhat initially uintuitive. It will treat the biundaries as the 0 coordinate from both sides, and thus always try to pick the one closest to 0
# We will use NOPBC for position, so that it doesn't do this and does cartesian coordinates normally. We do need to keep it enabled for COM however
c: COM ATOMS=42777-42788
p: POSITION ATOM=c NOPBC

# Our function for biasing the simulation
# Based on https://doi.org/10.1021/acs.jcim.9b00834 we will pull our molecule with force F(z) = k(delta_z - vt)
# Where k = 600kJ/(mol nm^2), v = 0.5nm/ns to 5nm/ns
# Although we will use v=0.2nm/ns to run for longer (40ns to cross our 8nm box)
# Note that the nature paper: https://doi.org/10.1038/s41598-019-42272-0 does not do this. They just crank the temperature up and do unbiased simulations instead
# Based on the PLUMED docs, this should replicate what happens in our first paper
# Also note that our bias value here is a potential not a force, and we can derive it using the fact F=-du/dz
# Finally, note that t is in ps not ns

# In terms of how we run this thing, this bit of code essentially creates a moving wall that bounces our ligand back and forth from 8.5 to 0.5 in p ps 
t: TIME

triangle: CUSTOM ARG=t VAR=t FUNC=2*abs(t/8000-floor(t/8000+1/2)) PERIODIC=NO # This creates a triangle wave with time period p ps
target: CUSTOM ARG=triangle VAR=triangle FUNC=8*triangle PERIODIC=NO # This then creates our target location for the triangle wave
diff: CUSTOM ARG=target,p.z VAR=target,z FUNC=target-(8.4-z) PERIODIC=NO # Calculate the difference between the 2
dir: CUSTOM ARG=t VAR=t FUNC=step(sin(2*pi*t/8000))*2-1 PERIODIC=NO # This calculates the sign, whether we're moving the molecule up or down

# This is the trick, we only apply the constraint if our ligand is "behind target". This can be done by using step(dir*diff).
# If the sign is the same, then our molecule must be behind target, so the constraint is applied
pot: CUSTOM ARG=diff,dir VAR=diff,dir FUNC=step(dir*diff)*0.5*600*(diff^2) PERIODIC=NO 
r: BIASVALUE ARG=pot

# Put some walls in so we don't have to deal with periodic boundary conditions for our ligand
uwall: UPPER_WALLS ARG=p.z AT=8.5 KAPPA=2000.0 EXP=2 EPS=1 OFFSET=0
lwall: LOWER_WALLS ARG=p.z AT=0.3 KAPPA=2000.0 EXP=2 EPS=1 OFFSET=0

# Since we're running a biased simulation, we need to reqeight the bias when computing our free energy
rwbias: REWEIGHT_BIAS ARG=r.bias,uwall.bias,lwall.bias TEMP=310
#rwbias: REWEIGHT_BIAS ARG=r.bias TEMP=310
h: HISTOGRAM ARG=p.z STRIDE=100 GRID_MIN=0.25 GRID_MAX=8.25 GRID_BIN=800 BANDWIDTH=0.1 LOGWEIGHTS=rwbias

# Convert the histogram to free energy
fe: CONVERT_TO_FES GRID=h TEMP=310

# This should leave a little bit of space for our molecule to wander around, but not enough to affect the membrane

DUMPGRID GRID=fe FILE=smd_fast_fe STRIDE=2500000
#PRINT ARG=G,vol,p.x,p.y,p.z,r.bias,uwall.bias,lwall.bias,rwbias STRIDE=10000 FILE=smd_fast_out
PRINT ARG=G,vol,p.x,p.y,p.z,dir,target,diff,pot,r.bias,uwall.bias,lwall.bias,rwbias STRIDE=10000 FILE=smd_fast_out
